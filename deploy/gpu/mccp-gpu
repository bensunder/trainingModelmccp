#!/usr/bin/env bash
# mccp-gpu: one command to run MCCP training/benchmark batches on a GPU box.
#
# First time on a box (Ubuntu + CUDA, as root):
#   curl -fsSL https://raw.githubusercontent.com/bensunder/trainingModelmccp/main/deploy/gpu/mccp-gpu | bash -s -- up
# Afterwards (installed as /usr/local/bin/mccp-gpu):
#   mccp-gpu up [--queue PROFILE...] [--no-baseline]   set up the box, start the queue runner
#   mccp-gpu queue add PROFILE [--n N] [--epochs E] [--seeds "42 7"]
#   mccp-gpu queue add PROFILE --n 100,300,1000 --methods sft,rgt --seeds 42 --test-n 300
#                                   learning curve: standard fine-tuning vs Rationale-Guided Training
#   mccp-gpu queue list | queue clear
#   mccp-gpu status                 current run, progress, GPU, cost so far, queue, finished runs
#   mccp-gpu results                comparison tables of finished runs
#   mccp-gpu logs                   follow the runner log (Ctrl+C stops following, not the run)
#   mccp-gpu baseline               (re)enter the frontier-baseline API key and model
#   mccp-gpu bench [--profile P] [--concurrency 1,5,10] [--duration 120] [--output-tokens 256]
#                  [--adapter DIR] [--rate INR_PER_HOUR] [--eager 0|1]
#                                   serving throughput + cost per 1M output tokens (no API calls)
#   mccp-gpu eval-messy [RUN_ID] [--n 300]
#                                   score a finished run's adapters on messy invoices (no retraining)
#   mccp-gpu stop [--yes]           stop the runner and free the GPU (queue is kept)
#   mccp-gpu update                 refresh the code used by *future* runs
#
# Guarantees:
#   * one runner per box (flock); runs execute one after another
#   * every run executes from its own frozen copy of the code (a release directory
#     per commit), so updating `main` never changes a run that is in progress
#   * the API key is read once from the terminal, verified for free, stored
#     root-only, and never appears on a command line
#   * waits for GPU work it did not start (e.g. a manual run_batch.sh) to finish
#   * results and logs land in /workspace (kept by GridShare after Stop)
# No `set -e` on purpose: every step checks its own result.

MCCP_HOME="${MCCP_HOME:-/root/.mccp}"
SRC="${MCCP_SRC:-/root/mccp-src}"
RELEASES="${MCCP_RELEASES:-/root/mccp-releases}"
RUNS_ROOT="${MCCP_RUNS:-/root/mccp-runs}"
WORKSPACE="${MCCP_WORKSPACE:-/workspace}"
REPO_URL="${MCCP_REPO_URL:-https://github.com/bensunder/trainingModelmccp}"
BRANCH="${MCCP_BRANCH:-main}"
SESSION="${MCCP_SESSION:-mccp-gpu}"
BIN_LINK="${MCCP_BIN_LINK:-/usr/local/bin/mccp-gpu}"
QUEUE="$MCCP_HOME/queue.tsv"      # id <TAB> profile <TAB> sizes <TAB> epochs <TAB> seeds <TAB> methods <TAB> test_n
DONE="$MCCP_HOME/done.tsv"        # id <TAB> profile <TAB> rc <TAB> results_dir <TAB> ended_utc
CURRENT="$MCCP_HOME/current.env"
CONFIG="$MCCP_HOME/config.env"    # baseline URL/model, GPU rate (not secret)
SECRETS="$MCCP_HOME/secrets.env"  # API key (0600)
RUNNER_LOG="$MCCP_HOME/runner.log"
DEFAULT_PROFILE="qwen3-8b@v1"
# Process patterns, anchored to the start of the command line so they match the real
# processes and not a shell or editor whose command text merely mentions them.
P_BATCH='^(/usr/bin/|/bin/)?bash [^ ]*run_batch\.sh'
P_TRAINER='^[^ ]*python[0-9.]* [^ ]*mccp_trainer_entry\.py'
P_VLLM='^[^ ]*(python[0-9.]* +)?[^ ]*vllm serve '
P_RUNNER='^(/usr/bin/|/bin/)?bash [^ ]*runner\.sh _run$'
P_BENCH='^(/usr/bin/|/bin/)?bash [^ ]*bench\.sh$'
BENCH_SESSION="${MCCP_BENCH_SESSION:-mccp-bench}"
DEFAULT_GPU_RATE_INR=30.5     # RTX 4000 Ada on GridShare when last checked; override with --rate
DEFAULT_USD_PER_INR=0.0105    # about INR 95 per USD (Nov 2026); only for the $ column

export PATH="$HOME/.local/bin:$PATH"
umask 077
mkdir -p "$MCCP_HOME"

c_ok() { printf '\033[32m%s\033[0m\n' "$*"; }
c_warn() { printf '\033[33m%s\033[0m\n' "$*"; }
log() { echo "[$(date -u +%H:%M:%S)] $*" | tee -a "$RUNNER_LOG"; }
fail() { printf '\033[31mSTOP: %s\033[0m\n' "$*" >&2; exit 1; }

# ------------------------------------------------------------------ source --
ensure_src() {  # the tool-owned checkout that new releases are cut from
  if [ -d "$SRC/.git" ]; then
    git -C "$SRC" fetch -q origin "$BRANCH" 2>/dev/null || { c_warn "git fetch failed; using the local copy"; return 0; }
    git -C "$SRC" checkout -q "$BRANCH" 2>/dev/null || git -C "$SRC" checkout -q -B "$BRANCH" "origin/$BRANCH"
    git -C "$SRC" reset -q --hard "origin/$BRANCH"
  else
    git clone -q -b "$BRANCH" "$REPO_URL" "$SRC" || fail "could not clone $REPO_URL"
  fi
}

install_link() {
  local target="$SRC/deploy/gpu/mccp-gpu"
  [ -w "$(dirname "$BIN_LINK")" ] || return 0
  printf '#!/usr/bin/env bash\nexec bash %q "$@"\n' "$target" > "$BIN_LINK" && chmod 755 "$BIN_LINK"
}

# Piped from curl (or run from anywhere else): get the source, then re-exec from it.
# (When piped, BASH_SOURCE is empty, so SELF is empty and never matches.)
SELF="$(readlink -f "${BASH_SOURCE[0]:-/dev/stdin}" 2>/dev/null)"
SRC_SELF="$(readlink -f "$SRC/deploy/gpu/mccp-gpu" 2>/dev/null)"
if [ "${MCCP_GPU_REEXEC:-0}" != 1 ] && [ "${1:-}" != "_run" ] \
   && { [ -z "$SRC_SELF" ] || [ ! -f "$SRC_SELF" ] || [ "$SELF" != "$SRC_SELF" ]; }; then
  command -v git >/dev/null || fail "git is required"
  ensure_src
  install_link
  MCCP_GPU_REEXEC=1 exec bash "$SRC/deploy/gpu/mccp-gpu" "$@"
fi

# ---------------------------------------------------------------- releases --
release_for() {  # $1 commit -> prints a frozen, installed copy of that commit
  local sha="$1" rel="$RELEASES/$1"
  if [ ! -f "$rel/.ready" ]; then
    rm -rf "$rel" && mkdir -p "$rel"
    git -C "$SRC" archive "$sha" | tar -x -C "$rel" || return 1
    touch "$rel/.ready"   # bootstrap.sh installs its environment (uv sync --frozen)
  fi
  prune_releases "$sha"
  echo "$rel"
}

prune_releases() {  # keep the newest 3 releases plus $1 (never the one a run is using)
  local keep="$1" in_use="" d
  [ -f "$CURRENT" ] && in_use="$(grep -E '^RUN_RELEASE=' "$CURRENT" | cut -d= -f2)"
  find "$RELEASES" -mindepth 1 -maxdepth 1 -type d -printf '%T@ %f\n' 2>/dev/null | sort -rn | tail -n +4 \
    | while read -r _ d; do
        [ "$d" = "$keep" ] || [ "$d" = "$in_use" ] || rm -rf "${RELEASES:?}/$d"
      done
}

# ------------------------------------------------------------------- queue --
with_queue_lock() { (flock 8; "$@") 8>"$MCCP_HOME/queue.lock"; }

_queue_add() {  # profile sizes epochs seeds [methods] [test_n]
  local id
  id="$(date -u +%Y%m%d-%H%M%S)-$(printf '%s' "$1" | tr -c 'a-z0-9.-' '-' | sed 's/-*$//')"
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$id" "$1" "$2" "$3" "$4" "${5:-sft}" "${6:-}" >> "$QUEUE"
  echo "$id"
}

_queue_pop_if() {  # remove the first line only if it is still item $1
  [ -s "$QUEUE" ] || return 0
  if [ "$(head -1 "$QUEUE" | cut -f1)" = "$1" ]; then
    tail -n +2 "$QUEUE" > "$QUEUE.tmp" && mv "$QUEUE.tmp" "$QUEUE"
  fi
}

valid_profile() {  # profile must exist in the source checkout
  [ -f "$SRC/profiles/$1.yaml" ] || fail "unknown profile $1 (available: $(find "$SRC/profiles" -maxdepth 1 -name '*.yaml' -printf '%f ' | sed 's/\.yaml//g'))"
}

cmd_queue() {
  case "${1:-list}" in
    add)
      shift
      local profile="${1:-}" n=3000 epochs=1 seeds="42 7" methods=sft test_n=""
      [ -n "$profile" ] || fail "usage: mccp-gpu queue add PROFILE [--n N[,N...]] [--epochs E] [--seeds \"42 7\"] [--methods sft,rgt] [--test-n N]"
      shift
      while [ $# -gt 0 ]; do
        case "$1" in
          --n) n="$2"; shift 2 ;;
          --epochs) epochs="$2"; shift 2 ;;
          --seeds) seeds="$2"; shift 2 ;;
          --methods) methods="$2"; shift 2 ;;
          --test-n) test_n="$2"; shift 2 ;;
          *) fail "unknown option $1" ;;
        esac
      done
      [[ "$n" =~ ^[0-9]+(,[0-9]+)*$ && "$epochs" =~ ^[0-9]+$ && "$seeds" =~ ^[0-9\ ,]+$ ]] \
        || fail "--n numbers (comma list for a curve), --epochs a number, --seeds numbers"
      [[ "$methods" =~ ^(sft|rgt)(,(sft|rgt))*$ ]] || fail "--methods must be sft, rgt or sft,rgt"
      [ -z "$test_n" ] || [[ "$test_n" =~ ^[0-9]+$ ]] || fail "--test-n must be a number"
      [[ "$n" != *,* ]] || [ -n "$test_n" ] || fail "several --n sizes need --test-n (one fixed test set for every size)"
      valid_profile "$profile"
      local id
      id="$(with_queue_lock _queue_add "$profile" "$n" "$epochs" "$seeds" "$methods" "$test_n")"
      c_ok "queued $id ($profile, methods $methods, records $n x $epochs epoch, seeds $seeds${test_n:+, fixed test $test_n})"
      runner_active || start_runner
      ;;
    list)
      if [ -s "$QUEUE" ]; then
        awk -F'\t' '{printf "  %d. %s  %s  %s n=%s e=%s seeds=[%s]%s\n", NR, $1, $2, ($6==""?"sft":$6), $3, $4, $5, ($7==""?"":" test=" $7)}' "$QUEUE"
      else
        echo "  (queue empty)"
      fi
      ;;
    clear) with_queue_lock bash -c ": > '$QUEUE'"; c_ok "queue cleared (a run in progress continues)" ;;
    *) fail "usage: mccp-gpu queue add|list|clear" ;;
  esac
}

# ---------------------------------------------------------------- baseline --
# Providers: name | base URL(s) to try | model filter | default model | params to drop
# Kimi: temperature is fixed by the provider (any other value is a 400); thinking is
# switched off so it answers in the same token budget as the other targets.
provider_info() {
  case "$1" in
    openai) P_NAME="OpenAI"; P_URLS="https://api.openai.com"
            P_FILTER='^(gpt-|o[0-9])'; P_DEFAULT="gpt-4.1"; P_DROP="" ;;
    kimi)   P_NAME="Moonshot Kimi"; P_URLS="https://api.moonshot.ai https://api.moonshot.cn"
            P_FILTER='^kimi-'; P_DEFAULT="kimi-k2.6"; P_DROP="temperature" ;;
    *) return 1 ;;
  esac
}

model_extra() {  # $1 provider $2 model -> request fields for that model
  case "$1:$2" in
    kimi:kimi-k2*) echo '{"thinking": {"type": "disabled"}}' ;;
    kimi:kimi-k3*) echo '{"reasoning_effort": "low"}' ;;
    *) echo "" ;;
  esac
}

model_price() {  # $1 model -> "in out" USD per 1M tokens (list prices; cost column only)
  case "$1" in
    gpt-4.1) echo "2 8" ;; gpt-4.1-mini) echo "0.4 1.6" ;; gpt-4.1-nano) echo "0.1 0.4" ;;
    gpt-4o) echo "2.5 10" ;; gpt-4o-mini) echo "0.15 0.6" ;;
    kimi-k2.6) echo "0.95 4" ;; kimi-k3) echo "3 15" ;;
    *) echo "" ;;
  esac
}

cmd_baseline() {
  local provider key models pick model url resp
  [ -r /dev/tty ] || fail "needs an interactive terminal"
  printf 'Frontier baseline provider: 1) OpenAI  2) Moonshot Kimi  3) none   [1]: '
  IFS= read -r pick </dev/tty
  case "${pick:-1}" in 1) provider=openai ;; 2) provider=kimi ;; 3) provider=none ;; *) fail "pick 1, 2 or 3" ;; esac
  if [ "$provider" = none ]; then
    printf 'BASELINE_DISABLED=1\n' > "$CONFIG.base"; rm -f "$SECRETS"
    c_warn "no frontier baseline: runs will compare adapter vs base only"
  fi
  [ "$provider" = none ] || provider_info "$provider"
  while [ "$provider" != none ]; do
    printf '%s API key (hidden; Enter alone = no baseline): ' "$P_NAME"
    IFS= read -rs key </dev/tty; echo
    key="$(printf '%s' "$key" | tr -d '[:space:]')"
    if [ -z "$key" ]; then
      printf 'BASELINE_DISABLED=1\n' > "$CONFIG.base"; rm -f "$SECRETS"
      c_warn "no frontier baseline: runs will compare adapter vs base only"
      break
    fi
    url=""; resp=""
    local u
    for u in $P_URLS; do   # Moonshot keys are region-locked: .ai (global) or .cn (mainland)
      resp="$(curl -s -m 20 "$u/v1/models" -H "Authorization: Bearer $key")"
      if printf '%s' "$resp" | grep -q '"data"'; then url="$u"; break; fi
    done
    if [ -z "$url" ]; then
      c_warn "key rejected: $(printf '%s' "$resp" | grep -o '"message": *"[^"]*"' | head -1)"
      continue
    fi
    mapfile -t models < <(printf '%s' "$resp" | grep -o '"id": *"[^"]*"' | sed 's/.*"\([^"]*\)"$/\1/' \
      | grep -E "$P_FILTER" | grep -viE 'audio|realtime|transcribe|tts|image|search|embedding|instruct|codex|vision|-code' | sort)
    [ "${#models[@]}" -gt 0 ] || { c_warn "this key lists no chat models"; continue; }
    local default=""
    for m in "${models[@]}"; do [ "$m" = "$P_DEFAULT" ] && default="$P_DEFAULT"; done
    if [ -n "$default" ]; then
      printf 'Key OK. Baseline model [Enter = %s, or type another id]: ' "$default"
      IFS= read -r pick </dev/tty
      model="${pick:-$default}"
    else
      echo "Key OK. Models:"; printf '  %s\n' "${models[@]}"
      printf 'Type the model id to compare against: '
      IFS= read -r model </dev/tty
    fi
    printf '%s\n' "${models[@]}" | grep -qx "$model" || { c_warn "$model is not in this key's model list"; continue; }
    local extra; extra="$(model_extra "$provider" "$model")"
    # A listed model is not a funded account: one tiny completion (a fraction of a cent)
    # catches "no credit" now instead of hours later at evaluation.
    local body code
    body="$(printf '{"model": "%s", "messages": [{"role": "user", "content": "Reply OK."}], "max_completion_tokens": 16%s}' \
      "$model" "${extra:+, ${extra:1:${#extra}-2}}")"
    [ "$provider" = kimi ] && body="${body/max_completion_tokens/max_tokens}"
    resp="$(curl -s -m 60 -o /dev/stdout -w '\n%{http_code}' "$url/v1/chat/completions" \
      -H "Authorization: Bearer $key" -H 'Content-Type: application/json' -d "$body")"
    code="$(printf '%s' "$resp" | tail -1)"
    if [ "$code" != 200 ]; then
      c_warn "test call failed (HTTP $code): $(printf '%s' "$resp" | grep -o '"message": *"[^"]*"' | head -1)"
      c_warn "fix the account (credit/billing) and enter the key again, or press Enter alone to skip"
      continue
    fi
    printf 'MCCP_BASELINE_API_KEY=%q\n' "$key" > "$SECRETS" && chmod 600 "$SECRETS"
    {
      printf 'BASELINE_PROVIDER=%q\nBASELINE_URL=%q\nBASELINE_MODEL=%q\n' "$provider" "$url" "$model"
      [ -n "$P_DROP" ] && printf 'BASELINE_DROP=%q\n' "$P_DROP"
      [ -n "$extra" ] && printf 'BASELINE_EXTRA_BODY=%q\n' "$extra"
      local price; price="$(model_price "$model")"
      [ -n "$price" ] && printf 'BASELINE_PRICE_IN=%s\nBASELINE_PRICE_OUT=%s\n' "${price% *}" "${price#* }"
    } > "$CONFIG.base"
    c_ok "frontier baseline: $P_NAME $model at $url (test call OK; key stored root-only in $SECRETS)"
    break
  done
  { cat "$CONFIG.base"; grep -E '^GPU_RATE_INR=' "$CONFIG" 2>/dev/null || true; } > "$CONFIG.new" && mv "$CONFIG.new" "$CONFIG"
  rm -f "$CONFIG.base"
}

# ------------------------------------------------------------------ runner --
runner_active() {  # a live runner loop, not just any process holding the lock file
  [ -f "$MCCP_HOME/runner.lock" ] || return 1
  flock -n "$MCCP_HOME/runner.lock" true 2>/dev/null && return 1
  pgrep -f "$P_RUNNER" >/dev/null
}

start_runner() {
  local frozen="$MCCP_HOME/runner.sh"
  cp "$SRC/deploy/gpu/mccp-gpu" "$frozen" && chmod 700 "$frozen"   # the loop never changes under itself
  if command -v tmux >/dev/null && [ "${MCCP_GPU_NO_TMUX:-0}" != 1 ]; then
    tmux has-session -t "$SESSION" 2>/dev/null && tmux kill-session -t "$SESSION"
    tmux new-session -d -s "$SESSION" "MCCP_GPU_REEXEC=1 bash '$frozen' _run"
  else
    MCCP_GPU_REEXEC=1 nohup bash "$frozen" _run >> "$RUNNER_LOG" 2>&1 &
  fi
  sleep 1
  c_ok "runner started (tmux session '$SESSION'); safe to disconnect. Check with: mccp-gpu status"
}

foreign_gpu_work() { pgrep -f "$P_BATCH" >/dev/null || pgrep -f "$P_TRAINER" >/dev/null; }

cmd_run() {  # internal: the queue loop (exactly one per box)
  exec 9>"$MCCP_HOME/runner.lock"
  if ! flock -n 9; then
    if pgrep -f "$P_RUNNER" | grep -vqx "$$"; then echo "a runner is already active"; exit 0; fi
    # Lock held by a leftover child of an earlier runner (e.g. a vLLM it started).
    log "runner lock held by pids: $(fuser "$MCCP_HOME/runner.lock" 2>/dev/null); stop them (mccp-gpu stop) and run: mccp-gpu up"
    exit 1
  fi
  log "runner up (pid $$)"
  while true; do
    local item
    item="$(head -1 "$QUEUE" 2>/dev/null)"
    if [ -z "$item" ]; then
      rm -f "$CURRENT"; log "queue empty; runner exiting"; exit 0
    fi
    local id profile n epochs seeds
    local methods test_n
    IFS=$'\t' read -r id profile n epochs seeds methods test_n <<<"$item"
    if foreign_gpu_work || bench_active; then
      log "waiting for other GPU work (a benchmark or a manual run) to finish (checks every 60 s)"
      while foreign_gpu_work || bench_active; do sleep 60; done
    fi
    git -C "$SRC" fetch -q origin "$BRANCH" 2>/dev/null
    local sha rel
    sha="$(git -C "$SRC" rev-parse "origin/$BRANCH" 2>/dev/null || git -C "$SRC" rev-parse HEAD)"
    log "run $id: $profile methods=${methods:-sft} n=$n epochs=$epochs seeds=[$seeds]${test_n:+ test=$test_n} from commit ${sha:0:7}"
    rel="$(release_for "$sha")" || { log "could not prepare release ${sha:0:7}"; break; }
    if [ "${MCCP_GPU_SKIP_BOOTSTRAP:-0}" != 1 ]; then
      if ! REPO="$rel" BOOTSTRAP_NO_GIT=1 LOG="$MCCP_HOME/bootstrap.log" bash "$rel/deploy/gpu/bootstrap.sh" >> "$RUNNER_LOG" 2>&1; then
        log "bootstrap failed (see $MCCP_HOME/bootstrap.log); queue paused"; break
      fi
    fi
    local runs="$RUNS_ROOT/$id" dest="$WORKSPACE/mccp-$id"
    printf 'RUN_ID=%q\nRUN_PROFILE=%q\nRUN_RELEASE=%q\nRUN_STARTED=%q\nRUN_DIR=%q\nRUN_DEST=%q\n' \
      "$id" "$profile" "$sha" "$(date +%s)" "$runs" "$dest" > "$CURRENT"
    (
      set -a
      # shellcheck disable=SC1090
      [ -f "$CONFIG" ] && . "$CONFIG"
      # shellcheck disable=SC1090
      [ -f "$SECRETS" ] && . "$SECRETS"
      set +a
      if [ "${BASELINE_DISABLED:-0}" = 1 ]; then unset BASELINE_URL BASELINE_MODEL MCCP_BASELINE_API_KEY; fi
      PROFILE="$profile" N="${n%%,*}" SIZES="${n//,/ }" METHODS="${methods:-sft}" TEST_N="${test_n:-}" \
        EPOCHS="$epochs" SEEDS="${seeds//,/ }" RUNS="$runs" DEST="$dest" REPO="$rel" \
        bash "${MCCP_GPU_BATCH_CMD:-$rel/deploy/gpu/run_batch.sh}" 9>&-
    ) >> "$RUNNER_LOG" 2>&1   # 9>&-: the batch (and the vLLM it starts) must not inherit the runner lock
    local rc=$?
    printf '%s\t%s\t%s\t%s\t%s\n' "$id" "$profile" "$rc" "$dest" "$(date -u +%FT%TZ)" >> "$DONE"
    with_queue_lock _queue_pop_if "$id"
    rm -f "$CURRENT"
    if [ "$rc" != 0 ]; then
      log "run $id FAILED (exit $rc); queue paused so no more GPU time is spent. See: mccp-gpu logs"
      break
    fi
    log "run $id done: $dest (comparison.md or curve.md)"
  done
}

# ------------------------------------------------------------------- status --
cmd_status() {
  local rate; rate="$(gpu_rate)"
  if runner_active; then c_ok "runner: active"; else echo "runner: idle"; fi
  if [ -f "$CURRENT" ]; then
    # shellcheck disable=SC1090,SC2153  # RUN_* come from this file
    . "$CURRENT"
    local secs=$(( $(date +%s) - RUN_STARTED ))
    # shellcheck disable=SC2153  # RUN_ID is set by sourcing $CURRENT
    printf 'current: %s  (%s, commit %s)\n' "$RUN_ID" "$RUN_PROFILE" "${RUN_RELEASE:0:7}"
    printf 'elapsed: %dh%02dm   est. GPU cost so far: INR %s\n' $((secs / 3600)) $((secs % 3600 / 60)) \
      "$(awk -v s="$secs" -v r="$rate" 'BEGIN{printf "%.0f", s/3600*r}')"
    local tl
    tl="$(find "$RUN_DIR" -mindepth 2 -maxdepth 2 -name train.log -printf '%T@ %p\n' 2>/dev/null | sort -rn | head -1 | cut -d' ' -f2-)"
    [ -n "$tl" ] && printf 'training: %s  %s\n' "$(basename "$(dirname "$tl")")" \
      "$(tail -c 400 "$tl" | tr '\r' '\n' | grep -aE '[0-9]+/[0-9]+ \[' | tail -1 | sed 's/^ *//')"
    printf 'last event: %s\n' "$(grep -aE '^\[' "$RUNNER_LOG" 2>/dev/null | tail -1)"
  fi
  if command -v nvidia-smi >/dev/null; then
    printf 'GPU: %s\n' "$(nvidia-smi --query-gpu=name,utilization.gpu,memory.used,memory.total --format=csv,noheader 2>/dev/null)"
  fi
  if bench_active; then
    local bd; bd="$(cat "$MCCP_HOME/bench.last" 2>/dev/null)"
    c_ok "benchmark: running ($bd)"
    printf '  last: %s\n' "$(grep -aE '^\[|concurrency|tok/s' "$bd/console.txt" 2>/dev/null | tail -1)"
  elif [ -f "$MCCP_HOME/bench.last" ]; then
    local bd; bd="$(cat "$MCCP_HOME/bench.last")"
    if [ -f "$bd/throughput.md" ]; then echo "last benchmark: done ($bd/throughput.md; mccp-gpu results)"
    else c_warn "last benchmark ended without results: tail -30 $bd/console.txt"; fi
  fi
  if foreign_gpu_work && [ ! -f "$CURRENT" ]; then c_warn "GPU busy with a run started outside mccp-gpu"; fi
  echo "queue:"; cmd_queue list
  if [ -s "$DONE" ]; then
    echo "finished:"
    tail -5 "$DONE" | awk -F'\t' '{printf "  %s  %s  %s  %s\n", $1, $2, ($3=="0"?"ok":"FAILED rc=" $3), $4}'
  fi
}

cmd_results() {
  local any=0 f
  if [ -s "$DONE" ]; then
    any=1
    while IFS=$'\t' read -r id profile rc dest _; do
      echo "=== $id ($profile) ==="
      if [ "$rc" = 0 ] && [ -f "$dest/curve.md" ]; then cat "$dest/curve.md"
    elif [ "$rc" = 0 ] && [ -f "$dest/comparison.md" ]; then cat "$dest/comparison.md"
    else echo "(no results: rc=$rc)"; fi
      echo
    done < "$DONE"
  fi
  for f in "$WORKSPACE"/mccp-bench-*/throughput.md; do
    [ -f "$f" ] || continue
    any=1; echo "=== benchmark $(basename "$(dirname "$f")") ==="; cat "$f"; echo
  done
  [ "$any" = 1 ] || echo "no finished runs or benchmarks yet"
}

cmd_stop() {
  if [ "${1:-}" != "--yes" ]; then
    [ -r /dev/tty ] || fail "use: mccp-gpu stop --yes"
    printf 'Stop the runner, any benchmark and any training/vLLM on this box? The queue is kept. [y/N] '
    local a; IFS= read -r a </dev/tty; [ "$a" = y ] || [ "$a" = Y ] || { echo "cancelled"; return 0; }
  fi
  command -v tmux >/dev/null && { tmux kill-session -t "$SESSION" 2>/dev/null; tmux kill-session -t "$BENCH_SESSION" 2>/dev/null; }
  local p
  for p in "$P_RUNNER" "$P_BATCH" "$P_BENCH" "$P_TRAINER" "$P_VLLM"; do pkill -f "$p" 2>/dev/null; done
  sleep 3
  for p in "$P_RUNNER" "$P_BATCH" "$P_BENCH" "$P_TRAINER" "$P_VLLM"; do pkill -9 -f "$p" 2>/dev/null; done
  rm -f "$CURRENT"
  c_ok "stopped; the interrupted run stays first in the queue. Resume with: mccp-gpu up (training continues from its last checkpoint)"
}

gpu_rate() {  # INR per hour: --rate value, else config, else default
  local r=""
  [ -f "$CONFIG" ] && r="$(grep -E '^GPU_RATE_INR=' "$CONFIG" | tail -1 | cut -d= -f2)"
  echo "${r:-$DEFAULT_GPU_RATE_INR}"
}

set_config() {  # key value: replace or add one line in config.env
  touch "$CONFIG"
  { grep -vE "^$1=" "$CONFIG"; printf '%s=%s\n' "$1" "$2"; } > "$CONFIG.new" && mv "$CONFIG.new" "$CONFIG"
}

bench_active() { { command -v tmux >/dev/null && tmux has-session -t "$BENCH_SESSION" 2>/dev/null; } || pgrep -f "$P_BENCH" >/dev/null; }

cmd_bench() {
  local profile="$DEFAULT_PROFILE" conc="1,5,10" dur=120 out=256 adapter="" rate="" eager=1
  while [ $# -gt 0 ]; do
    case "$1" in
      --profile) profile="$2"; shift 2 ;;
      --concurrency) conc="$2"; shift 2 ;;
      --duration) dur="$2"; shift 2 ;;
      --output-tokens) out="$2"; shift 2 ;;
      --adapter) adapter="$2"; shift 2 ;;
      --rate) rate="$2"; shift 2 ;;
      --eager) eager="$2"; shift 2 ;;
      *) fail "unknown option $1 (see: mccp-gpu help)" ;;
    esac
  done
  [[ "$conc" =~ ^[0-9]+(,[0-9]+)*$ && "$dur" =~ ^[0-9]+$ && "$out" =~ ^[0-9]+$ && "$eager" =~ ^[01]$ ]] \
    || fail "--concurrency 1,5,10  --duration seconds  --output-tokens N  --eager 0|1"
  local c; for c in ${conc//,/ }; do [ "$c" -ge 1 ] && [ "$c" -le 16 ] || fail "concurrency $c: allowed 1-16 (vLLM is started with 16 sequences)"; done
  [ -z "$rate" ] || [[ "$rate" =~ ^[0-9]+(\.[0-9]+)?$ ]] || fail "--rate must be a number (INR per hour)"
  [ -z "$adapter" ] || [ -f "$adapter/adapter_config.json" ] || fail "no LoRA adapter at $adapter"
  valid_profile "$profile"
  runner_active && fail "the training runner is active; wait for it (mccp-gpu status) or mccp-gpu stop"
  bench_active && fail "a benchmark is already running (tmux attach -t $BENCH_SESSION)"
  foreign_gpu_work && fail "GPU busy with work started outside mccp-gpu"
  [ -n "$rate" ] && set_config GPU_RATE_INR "$rate"
  rate="$(gpu_rate)"
  [ "$rate" = "$DEFAULT_GPU_RATE_INR" ] && c_warn "using GPU price INR $rate/h; pass --rate <your GridShare INR/h> if it differs"
  local sha rel
  sha="$(git -C "$SRC" rev-parse HEAD)"
  rel="$(release_for "$sha")" || fail "could not prepare release ${sha:0:7}"
  if [ "${MCCP_GPU_SKIP_BOOTSTRAP:-0}" != 1 ]; then
    REPO="$rel" BOOTSTRAP_NO_GIT=1 LOG="$MCCP_HOME/bootstrap.log" bash "$rel/deploy/gpu/bootstrap.sh" \
      || fail "bootstrap failed (details above)"
  fi
  local id dest levels
  id="$(date -u +%Y%m%d-%H%M%S)-$(printf '%s' "$profile" | tr -c 'a-z0-9.-' '-' | sed 's/-*$//')"
  dest="$WORKSPACE/mccp-bench-$id"
  mkdir -p "$dest"
  levels=$(( $(tr -cd ',' <<<"$conc" | wc -c) + 1 ))
  local envs
  envs="$(printf 'REPO=%q DEST=%q PROFILE=%q CONCURRENCY=%q DURATION=%q OUTPUT_TOKENS=%q ADAPTER_DIR=%q GPU_RATE_INR=%q USD_PER_INR=%q EAGER=%q' \
    "$rel" "$dest" "$profile" "$conc" "$dur" "$out" "$adapter" "$rate" "$DEFAULT_USD_PER_INR" "$eager")"
  local cmd="$envs bash ${MCCP_GPU_BENCH_CMD:-$rel/deploy/gpu/bench.sh}"
  if command -v tmux >/dev/null && [ "${MCCP_GPU_NO_TMUX:-0}" != 1 ]; then
    tmux new-session -d -s "$BENCH_SESSION" "$cmd > '$dest/console.txt' 2>&1"
  else
    nohup bash -c "$cmd" > "$dest/console.txt" 2>&1 &
  fi
  printf '%s\n' "$dest" > "$MCCP_HOME/bench.last"
  c_ok "benchmark started: $profile, concurrency [$conc], ${dur}s per level, ${out} output tokens per request"
  echo "  about $(( (levels * (dur + 30) + 300) / 60 )) min including vLLM start-up (model download adds ~5 min if missing)"
  echo "  about INR $(awk -v l="$levels" -v d="$dur" -v r="$rate" 'BEGIN{printf "%.0f", (l*(d+30)+300)/3600*r}') of GPU time; no API calls"
  echo "  results: $dest/throughput.md   check with: mccp-gpu status"
}

cmd_eval_messy() {
  local run_id="" n=300
  while [ $# -gt 0 ]; do
    case "$1" in
      --n) n="$2"; shift 2 ;;
      -*) fail "unknown option $1" ;;
      *) run_id="$1"; shift ;;
    esac
  done
  [[ "$n" =~ ^[0-9]+$ ]] && [ "$n" -gt 0 ] || fail "--n must be a positive number"
  [ -s "$DONE" ] || fail "no finished runs"
  local line
  if [ -n "$run_id" ]; then line="$(awk -F'\t' -v id="$run_id" '$1==id' "$DONE" | tail -1)"
  else line="$(awk -F'\t' '$3=="0"' "$DONE" | tail -1)"; fi
  [ -n "$line" ] || fail "no successful finished run${run_id:+ with id $run_id}"
  local id profile rc dest
  IFS=$'\t' read -r id profile rc dest _ <<<"$line"
  [ "$rc" = 0 ] || fail "run $id did not finish successfully (rc=$rc)"
  [ -d "$RUNS_ROOT/$id" ] || fail "$RUNS_ROOT/$id is gone (machine was stopped?); adapters must still be on this box"
  runner_active && fail "the training runner is active; wait for it (mccp-gpu status)"
  bench_active && fail "a benchmark is running"
  { command -v tmux >/dev/null && tmux has-session -t mccp-messy 2>/dev/null; } && fail "a messy eval is already running (tmux attach -t mccp-messy)"
  foreign_gpu_work && fail "GPU busy with work started outside mccp-gpu"
  local sha rel
  sha="$(git -C "$SRC" rev-parse HEAD)"
  rel="$(release_for "$sha")" || fail "could not prepare release ${sha:0:7}"
  if [ "${MCCP_GPU_SKIP_BOOTSTRAP:-0}" != 1 ]; then
    REPO="$rel" BOOTSTRAP_NO_GIT=1 LOG="$MCCP_HOME/bootstrap.log" bash "$rel/deploy/gpu/bootstrap.sh" \
      || fail "bootstrap failed (details above)"
  fi
  local cmd
  cmd="$(printf 'RUN_DIR=%q DEST=%q PROFILE=%q MESSY_N=%q REPO=%q' "$RUNS_ROOT/$id" "$dest" "$profile" "$n" "$rel") bash ${MCCP_GPU_MESSY_CMD:-$rel/deploy/gpu/eval_messy.sh}"
  mkdir -p "$dest"
  if command -v tmux >/dev/null && [ "${MCCP_GPU_NO_TMUX:-0}" != 1 ]; then
    tmux new-session -d -s mccp-messy "$cmd > '$dest/eval-messy.console.txt' 2>&1"
  else
    nohup bash -c "$cmd" > "$dest/eval-messy.console.txt" 2>&1 &
  fi
  local adapters
  adapters="$(find "$RUNS_ROOT/$id" -mindepth 2 -maxdepth 2 -name report.json | wc -l)"
  c_ok "messy-invoice eval started for $id ($adapters adapters, $n records each)"
  echo "  about $(( (adapters * 4) + 3 )) min; about INR $(awk -v a="$adapters" -v r="$(gpu_rate)" 'BEGIN{printf "%.0f", (a*4+3)/60*r}') of GPU time; no API calls"
  echo "  progress: tail -f $dest/eval-messy.console.txt   results: mccp-gpu results"
}

cmd_up() {
  local queue_profiles=() no_baseline=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --queue) shift; while [ $# -gt 0 ] && [[ "$1" != --* ]]; do queue_profiles+=("$1"); shift; done ;;
      --no-baseline) no_baseline=1; shift ;;
      *) fail "unknown option $1 (see: mccp-gpu help)" ;;
    esac
  done
  [ "$(id -u)" = 0 ] || [ "${MCCP_GPU_ALLOW_NONROOT:-0}" = 1 ] || fail "run as root"
  echo "== MCCP GPU box setup =="
  if [ "${MCCP_GPU_SKIP_BOOTSTRAP:-0}" != 1 ]; then
    local sha rel
    sha="$(git -C "$SRC" rev-parse HEAD)"
    rel="$(release_for "$sha")" || fail "could not prepare release ${sha:0:7}"
    REPO="$rel" BOOTSTRAP_NO_GIT=1 LOG="$MCCP_HOME/bootstrap.log" bash "$rel/deploy/gpu/bootstrap.sh" \
      || fail "bootstrap failed (details above)"
  fi
  if [ "$no_baseline" = 1 ]; then
    { echo BASELINE_DISABLED=1; grep -E '^GPU_RATE_INR=' "$CONFIG" 2>/dev/null || true; } > "$CONFIG.new" && mv "$CONFIG.new" "$CONFIG"
    rm -f "$SECRETS"
  elif [ ! -f "$CONFIG" ]; then
    cmd_baseline
  else
    echo "baseline: $(grep -E '^BASELINE_(PROVIDER|MODEL|DISABLED)=' "$CONFIG" | tr '\n' ' ')  (change with: mccp-gpu baseline)"
  fi
  local p
  for p in "${queue_profiles[@]}"; do valid_profile "$p"; with_queue_lock _queue_add "$p" 3000 1 "42 7" >/dev/null; done
  if [ ! -s "$QUEUE" ]; then
    c_warn "queue is empty. Add a run, e.g.: mccp-gpu queue add $DEFAULT_PROFILE"
    return 0
  fi
  runner_active && { c_ok "runner already active"; return 0; }
  start_runner
}

case "${1:-help}" in
  up) shift; cmd_up "$@" ;;
  queue) shift; cmd_queue "$@" ;;
  status) cmd_status ;;
  results) cmd_results ;;
  logs) tail -n 40 -f "$RUNNER_LOG" ;;
  bench) shift; cmd_bench "$@" ;;
  eval-messy) shift; cmd_eval_messy "$@" ;;
  baseline) cmd_baseline ;;
  stop) shift; cmd_stop "$@" ;;
  update) ensure_src; install_link; c_ok "code updated to $(git -C "$SRC" log -1 --format='%h %s'); applies to future runs" ;;
  _run) cmd_run ;;
  help|-h|--help) sed -n '2,32p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) fail "unknown command $1 (see: mccp-gpu help)" ;;
esac
