# GPU host settings for the split topology. Copy to deploy/gpu/.env.
# VPS address on the private network (WireGuard/Tailscale). Never a public IP:
# Postgres and S3 traffic is not TLS-protected yet.
VPS_PRIVATE_ADDR=100.64.0.1

# From the VPS deploy/vps/.env (MCCP_APP_DB_PASSWORD, MINIO_ROOT_USER/PASSWORD).
MCCP_APP_DB_PASSWORD=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MCCP_S3_BUCKET=mccp

# Generated on this host.
VLLM_API_KEY=
LITELLM_MASTER_KEY=sk-
LITELLM_SALT_KEY=
LITELLM_DB_PASSWORD=
HF_TOKEN=

# Model pin (must match the recipe's base_model.revision).
QWEN3_8B_REVISION=REPLACE_WITH_COMMIT_SHA

# GPU layout: GPU 0 runs vLLM + guard (>= 48 GB at these fractions), TRAIN_GPU trains.
VLLM_GPU_MEM_FRACTION=0.70
GUARD_GPU_MEM_FRACTION=0.22
TRAIN_GPU=1
# Bind the gateway to the address agents use (private network recommended).
GATEWAY_BIND=127.0.0.1
