# Copy to deploy/.env and replace every value. Never commit the real file.
POSTGRES_PASSWORD=change-me
VLLM_API_KEY=change-me-vllm
LITELLM_MASTER_KEY=sk-change-me
LITELLM_SALT_KEY=change-me-salt
HF_TOKEN=
# Pin the exact Hugging Face commit you validated; must match the recipe.
QWEN3_8B_REVISION=REPLACE_WITH_COMMIT_SHA
# GPU 0 hosts both vLLM servers. Fractions must sum to < 0.95 and need a 48 GB
# card at these defaults (Qwen3-8B bf16 ~16.4 GB + KV cache; Qwen3Guard-Gen-4B
# bf16 ~8 GB + KV cache). On an 80 GB card use 0.60 / 0.15.
VLLM_GPU_MEM_FRACTION=0.70
GUARD_GPU_MEM_FRACTION=0.22
# GPU index used for training (vLLM uses GPU 0). One-GPU hosts: set 0 and
# stop vLLM during training, or use a second host for the worker.
TRAIN_GPU=1

# Auth: oidc for real use (Entra ID shown); dev only on a laptop.
MCCP_AUTH_MODE=oidc
MCCP_OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
MCCP_OIDC_AUDIENCE=api://mccp
MCCP_OIDC_JWKS_URL=https://login.microsoftonline.com/<tenant-id>/discovery/v2.0/keys
MCCP_DEV_JWT_SECRET=
